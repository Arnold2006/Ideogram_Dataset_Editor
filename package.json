{
  "name": "ideogram4-dataset-editor",
  "version": "0.1.0",
  "description": "Ideogram 4 Dataset Editor — FrameForge engine (5s, ctx 32768, flash-attn, GPU 99) + Ideogram UI (grid + bbox)",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.mjs",
    "server": "node server.mjs",
    "server:dev": "concurrently --kill-others --names \"vite,server\" \"vite --port 5173\" \"node server.mjs\"",
    "fetch-llama": "node scripts/fetch-llama.js",
    "dist": "vite build",
    "dist:portable": "vite build && node scripts/package-zip.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.0.5"
  }
}
