node_modules
dist
out
# keep portable in repo for update/ zip distribution — out is still gitignored by default,
# uncomment next line if you want to commit the portable:
# !out/win-unpacked

# Models — preserve user downloads across git pull / update.bat
# Ignore everything in models except .gitkeep (so gguf, mmproj, active.json survive updates)
models/*
!models/.gitkeep

# Config — preserve user prompt/settings
config/*
!config/.gitkeep

# Bin — preserve downloaded llama.cpp binaries (track only README)
bin/*
!bin/README.md
!bin/.gitkeep
# legacy explicit (kept for clarity, covered by bin/* above)
# bin/llama-server*
# bin/*.dll
# bin/*.zip
# bin/MicrosoftEdgeWebview2Setup.exe

update/current_requirements.txt
update/current_package_lock.txt
python_embeded/
!python_embeded/README.txt
.env
.DS_Store
Thumbs.db
